.mypy_cache/
.ruff_cache/
# pentest/ is local-only: developer-side adversarial harnesses
# kept off the published repo per request.  Run them from a local
# clone, do not commit the directory back.
pentest/

# Local scratch / scaffolding never meant for the repo.
.git-msg.tmp
.baseline-build.sh
.step*.sh
.run-*.sh
.smoke*.py
